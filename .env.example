# NoneBot2 配置
DRIVER=~fastapi
HOST=0.0.0.0   # 容器内 0.0.0.0 安全（8080 不对外暴露），本地调试建议用 127.0.0.1
PORT=8080
COMMAND_START=["/"]

# NapCat WebUI 管理密码（留空自动随机生成）
# WEBUI_TOKEN=

# OneBot WS 认证 Token（留空不启用认证；NoneBot 适配器读取此变量，会同步写入 NapCat 客户端配置）
# ONEBOT_ACCESS_TOKEN=

# 每日推荐目标群（逗号分隔的群号，留空则不开启每日推荐）
# TARGET_GROUPS=123456,789012

# 可选：指定 QQ 账号自动登录
# ACCOUNT=
